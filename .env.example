# Copy to .env, chmod 600 .env, and populate privately. Literal values only.
# Do not store credentials in CLI arguments or version control.
FARM_BIND=127.0.0.1
FARM_HTTP_PORT=8000
FARM_WS_PORT=8765
# FARM_DB=/absolute/path/to/existing/farm.db
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TLS=0
MQTT_USER=
MQTT_PASSWORD=
MQTT_PREFIX=
MQTT_TOPIC=application/+/device/+/event/up
# MQTT_CAFILE=/absolute/path/to/ca.pem
